# Optional. Align works with NO env file — set your provider + key in the
# in-app Settings page instead (stored in your browser only).
#
# These are just a default/fallback used when Settings is empty.

# anthropic | openai | google | openai-compatible
AI_PROVIDER=anthropic

# Your API key from the provider's developer console (NOT a chat subscription).
AI_API_KEY=

# Model id. Defaults per provider: claude-haiku-4-5 / gpt-4o-mini /
# gemini-2.0-flash / llama3.1
AI_MODEL=

# Only for AI_PROVIDER=openai-compatible (Ollama, LM Studio, Groq, OpenRouter…)
# e.g. http://localhost:11434/v1
AI_BASE_URL=

# Skip real API calls, return canned sample data.
MOCK_AI=false
